<Window x:Class="Recliner.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RECLINER — ComfyUI Instance Manager"
        Width="1160" Height="740"
        MinWidth="860" MinHeight="520"
        Background="{DynamicResource BgMain}"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI"
        FontSize="13">

    <Window.Resources>

        <!-- ── Accent button ─────────────────────────────────────────────────── -->
        <Style x:Key="AccentBtn" TargetType="Button">
            <Setter Property="Background"   Value="{DynamicResource Accent}"/>
            <Setter Property="Foreground"   Value="#ffffff"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding"      Value="18,7"/>
            <Setter Property="FontSize"     Value="12"/>
            <Setter Property="FontWeight"   Value="SemiBold"/>
            <Setter Property="Cursor"       Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource AccentHov}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource AccentPress}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource AccentDisabled}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TxtDim}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── Ghost button (secondary) ──────────────────────────────────────── -->
        <Style x:Key="GhostBtn" TargetType="Button">
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="Foreground"      Value="{DynamicResource TxtSecondary}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush"     Value="{DynamicResource BorderMid}"/>
            <Setter Property="Padding"         Value="12,5"/>
            <Setter Property="FontSize"        Value="12"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource BgSurface2}"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource TxtDim}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TxtPrimary}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource BgMain}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── Launch (green) button ─────────────────────────────────────────── -->
        <Style x:Key="LaunchBtn" TargetType="Button">
            <Setter Property="Background"   Value="#1a5c3a"/>
            <Setter Property="Foreground"   Value="#4ec9b0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush"  Value="#2a7a50"/>
            <Setter Property="Padding"      Value="20,9"/>
            <Setter Property="FontSize"     Value="13"/>
            <Setter Property="FontWeight"   Value="SemiBold"/>
            <Setter Property="Cursor"       Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#226040"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#0f4028"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── TextBox ───────────────────────────────────────────────────────── -->
        <Style x:Key="DarkTextBox" TargetType="TextBox">
            <Setter Property="Background"   Value="{DynamicResource BgInput}"/>
            <Setter Property="Foreground"   Value="{DynamicResource TxtPrimary}"/>
            <Setter Property="BorderBrush"  Value="{DynamicResource BorderMid}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding"      Value="8,5"/>
            <Setter Property="CaretBrush"   Value="{DynamicResource TxtPrimary}"/>
            <Setter Property="SelectionBrush" Value="{DynamicResource BgSelected}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          Focusable="False"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter Property="BorderBrush" Value="{DynamicResource Accent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>


        <!-- ── ScrollBar ─────────────────────────────────────────────────────── -->
        <Style TargetType="ScrollBar">
            <Setter Property="Background"   Value="Transparent"/>
            <Setter Property="Width"        Value="8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid>
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Background="{DynamicResource BgThumb}" CornerRadius="4" Margin="1"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── ListBox (instance sidebar) ───────────────────────────────────── -->
        <Style x:Key="SideListBox" TargetType="ListBox">
            <Setter Property="Background"         Value="Transparent"/>
            <Setter Property="BorderThickness"    Value="0"/>
            <Setter Property="Focusable"          Value="False"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
        </Style>

        <Style x:Key="SideListItem" TargetType="ListBoxItem">
            <Setter Property="Background"         Value="Transparent"/>
            <Setter Property="Foreground"         Value="{DynamicResource TxtSecondary}"/>
            <Setter Property="BorderThickness"    Value="0"/>
            <Setter Property="Padding"            Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Cursor"             Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="bd" Background="Transparent"
                                BorderThickness="3,0,0,0" BorderBrush="Transparent"
                                Padding="14,10,12,10">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource BgSurface2}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource BgSelected}"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── DataGrid ──────────────────────────────────────────────────────── -->
        <Style x:Key="DarkGrid" TargetType="DataGrid">
            <Setter Property="Background"         Value="{DynamicResource BgInput}"/>
            <Setter Property="Foreground"         Value="{DynamicResource TxtSecondary}"/>
            <Setter Property="BorderThickness"    Value="1"/>
            <Setter Property="BorderBrush"        Value="{DynamicResource BorderMid}"/>
            <Setter Property="RowBackground"      Value="{DynamicResource BgRow}"/>
            <Setter Property="AlternatingRowBackground" Value="{DynamicResource BgRowAlt}"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource GridLine}"/>
            <Setter Property="VerticalGridLinesBrush" Value="Transparent"/>
            <Setter Property="HeadersVisibility"  Value="Column"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="CanUserAddRows"      Value="False"/>
            <Setter Property="CanUserDeleteRows"   Value="False"/>
            <Setter Property="CanUserReorderColumns" Value="False"/>
            <Setter Property="IsReadOnly"          Value="True"/>
            <Setter Property="SelectionMode"       Value="Single"/>
            <Setter Property="SelectionUnit"       Value="FullRow"/>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background"    Value="{DynamicResource BgMain}"/>
            <Setter Property="Foreground"    Value="{DynamicResource TxtLabel}"/>
            <Setter Property="Padding"       Value="8,5"/>
            <Setter Property="FontSize"      Value="11"/>
            <Setter Property="FontWeight"    Value="SemiBold"/>
            <Setter Property="BorderBrush"   Value="{DynamicResource BorderMid}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="SeparatorBrush" Value="{DynamicResource BorderMid}"/>
        </Style>

        <Style TargetType="DataGridRow">
            <Setter Property="Background" Value="Transparent"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{DynamicResource BgSelected}"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource BgHover}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="DataGridCell">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding"         Value="8,4"/>
            <Setter Property="Foreground"      Value="{DynamicResource TxtSecondary}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}">
                            <ContentPresenter/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="Foreground" Value="{DynamicResource TxtPrimary}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ── Section header label ──────────────────────────────────────────── -->
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="Foreground"  Value="{DynamicResource SectionHeaderColor}"/>
            <Setter Property="FontSize"    Value="11"/>
            <Setter Property="FontWeight"  Value="SemiBold"/>
            <Setter Property="Margin"      Value="0,18,0,8"/>
        </Style>

        <!-- ── Info row label ────────────────────────────────────────────────── -->
        <Style x:Key="InfoLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TxtLabel}"/>
            <Setter Property="FontSize"   Value="12"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- ── Info row value ────────────────────────────────────────────────── -->
        <Style x:Key="InfoValue" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TxtPrimary}"/>
            <Setter Property="FontSize"   Value="12"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <!-- ── Editable port field — looks like InfoValue at rest ──────────── -->
        <Style x:Key="PortEdit" TargetType="TextBox">
            <Setter Property="Foreground"      Value="{DynamicResource ColGreen}"/>
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="BorderBrush"     Value="Transparent"/>
            <Setter Property="CaretBrush"      Value="{DynamicResource ColGreen}"/>
            <Setter Property="FontSize"        Value="12"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Padding"         Value="0"/>
            <Setter Property="Width"           Value="60"/>
            <Setter Property="MaxLength"       Value="5"/>
            <Setter Property="Cursor"          Value="IBeam"/>
            <Setter Property="ToolTip"         Value="Click to edit port — Enter to save, Esc to cancel"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource TxtDim}"/>
                            </Trigger>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                                <Setter TargetName="bd" Property="Background"  Value="{DynamicResource BgInput}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── Startup-args inline editor (same feel as PortEdit, full width) ─── -->
        <Style x:Key="ArgsEdit" TargetType="TextBox">
            <Setter Property="Foreground"          Value="{DynamicResource TxtPrimary}"/>
            <Setter Property="Background"          Value="Transparent"/>
            <Setter Property="BorderThickness"     Value="0,0,0,1"/>
            <Setter Property="BorderBrush"         Value="Transparent"/>
            <Setter Property="CaretBrush"          Value="{DynamicResource ColGreen}"/>
            <Setter Property="FontSize"            Value="12"/>
            <Setter Property="FontFamily"          Value="Consolas"/>
            <Setter Property="VerticalAlignment"   Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="Padding"             Value="0"/>
            <Setter Property="MaxLength"           Value="500"/>
            <Setter Property="Cursor"              Value="IBeam"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource TxtDim}"/>
                            </Trigger>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                                <Setter TargetName="bd" Property="Background"  Value="{DynamicResource BgInput}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── Badge ─────────────────────────────────────────────────────────── -->
        <Style x:Key="BadgeGreen" TargetType="Border">
            <Setter Property="Background"    Value="#1a4030"/>
            <Setter Property="BorderBrush"   Value="#2a6045"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius"  Value="3"/>
            <Setter Property="Padding"       Value="6,2"/>
        </Style>

        <Style x:Key="BadgeRed" TargetType="Border">
            <Setter Property="Background"    Value="#4a1a1a"/>
            <Setter Property="BorderBrush"   Value="#6a2a2a"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius"  Value="3"/>
            <Setter Property="Padding"       Value="6,2"/>
        </Style>

        <Style x:Key="BadgeBlue" TargetType="Border">
            <Setter Property="Background"    Value="#1a2a4a"/>
            <Setter Property="BorderBrush"   Value="#2a4a7a"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius"  Value="3"/>
            <Setter Property="Padding"       Value="6,2"/>
        </Style>

    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="52"/>  <!-- Header bar -->
            <RowDefinition Height="*"/>   <!-- Main content -->
            <RowDefinition Height="28"/>  <!-- Status bar -->
        </Grid.RowDefinitions>

        <!-- ════════════════════════════════════════════════════════════════════
             HEADER
             ════════════════════════════════════════════════════════════════════ -->
        <Border Grid.Row="0" Background="{DynamicResource BgHeader}"
                BorderBrush="{DynamicResource BorderDim}" BorderThickness="0,0,0,1">
            <Grid Margin="16,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Logo + title -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="28" Height="28" CornerRadius="6"
                            Background="{DynamicResource BgSelected}" Margin="0,0,10,0">
                        <TextBlock Text="⚡" FontSize="15"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="RECLINER:"
                                   Foreground="#ffe57f" FontSize="15" FontWeight="SemiBold"/>
                        <TextBlock Text="External ComfyUI Linux-Interoperable No-Error Regulator"
                                   Foreground="#ffe57f" FontSize="9"/>
                    </StackPanel>
                </StackPanel>

                <!-- Center: path display -->
                <TextBlock Grid.Column="1"
                           x:Name="TxtPathDisplay"
                           Foreground="{DynamicResource TxtDim}" FontSize="11"
                           FontFamily="Consolas"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"/>

                <!-- Right: action buttons -->
                <StackPanel Grid.Column="2" Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Button Style="{StaticResource AccentBtn}"
                            x:Name="BtnNewInstance" Content="＋  New Instance"
                            Margin="0,0,8,0"
                            Click="BtnNewInstance_Click"/>
                    <Button Style="{StaticResource GhostBtn}"
                            x:Name="BtnSettings" Content="⚙  Settings"
                            Click="BtnSettings_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ════════════════════════════════════════════════════════════════════
             MAIN CONTENT
             ════════════════════════════════════════════════════════════════════ -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="230" MinWidth="160" MaxWidth="340"/>
                <ColumnDefinition Width="4"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ── LEFT SIDEBAR ──────────────────────────────────────────────── -->
            <Border Grid.Column="0" Background="{DynamicResource BgInput}"
                    BorderBrush="{DynamicResource BorderDim}" BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="44"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Sidebar header + count -->
                    <Border Grid.Row="0" Background="{DynamicResource BgHeader}"
                            BorderBrush="{DynamicResource BorderDim}" BorderThickness="0,0,0,1"
                            Padding="14,0">
                        <Grid>
                            <TextBlock Text="INSTANCES"
                                       Foreground="{DynamicResource TxtLabel}" FontSize="10"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"/>
                            <Border x:Name="CountBadge"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Background="{DynamicResource BgSelected}" CornerRadius="10"
                                    Padding="7,1">
                                <TextBlock x:Name="TxtCount"
                                           Foreground="{DynamicResource Accent}" FontSize="10"
                                           FontWeight="SemiBold" Text="0"/>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Instance list -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ListBox x:Name="ListInstances"
                                 Style="{StaticResource SideListBox}"
                                 ItemContainerStyle="{StaticResource SideListItem}"
                                 SelectionChanged="ListInstances_SelectionChanged">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition/>
                                            <RowDefinition/>
                                        </Grid.RowDefinitions>

                                        <!-- Instance name -->
                                        <TextBlock Grid.Row="0"
                                                   Text="{Binding DirectoryName}"
                                                   Foreground="{DynamicResource TxtPrimary}"
                                                   FontSize="13" FontWeight="Medium"
                                                   TextTrimming="CharacterEllipsis"/>

                                        <!-- Sub-info -->
                                        <TextBlock Grid.Row="1"
                                                   Text="{Binding StatusSummary}"
                                                   Foreground="{DynamicResource TxtDim}"
                                                   FontSize="10"
                                                   Margin="0,2,0,0"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </ScrollViewer>

                </Grid>
            </Border>

            <!-- Splitter -->
            <GridSplitter Grid.Column="1" Width="4"
                          Background="{DynamicResource BgSurface}" HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch" ResizeBehavior="PreviousAndNext"/>

            <!-- ── RIGHT PANEL ────────────────────────────────────────────────── -->
            <Grid Grid.Column="2" Background="{DynamicResource BgMain}">

                <!-- Empty state -->
                <StackPanel x:Name="PanelEmpty"
                            VerticalAlignment="Center" HorizontalAlignment="Center"
                            Visibility="Visible">
                    <TextBlock Text="⚡" FontSize="48"
                               HorizontalAlignment="Center"
                               Foreground="{DynamicResource BgSurface2}"/>
                    <TextBlock Text="Select an instance"
                               Foreground="{DynamicResource TxtDim}" FontSize="15"
                               HorizontalAlignment="Center" Margin="0,12,0,4"/>
                    <TextBlock Text="Choose a ComfyUI installation from the left panel"
                               Foreground="{DynamicResource BgSurface2}" FontSize="12"
                               HorizontalAlignment="Center"/>
                </StackPanel>

                <!-- Detail panel (hidden until selection) -->
                <ScrollViewer x:Name="PanelDetail"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Visibility="Collapsed"
                              Padding="28,20,28,28">
                    <StackPanel>

                        <!-- ── Instance header ──────────────────────────────── -->
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock x:Name="TxtInstanceName"
                                           Foreground="{DynamicResource TxtPrimary}" FontSize="20"
                                           FontWeight="SemiBold"/>
                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                    <Border x:Name="BadgeHasManifest" CornerRadius="3"
                                            Padding="6,2" Margin="0,0,8,0">
                                        <TextBlock x:Name="TxtManifestBadge"
                                                   FontSize="10" FontWeight="SemiBold"/>
                                    </Border>
                                    <TextBlock x:Name="TxtGeneratedAt"
                                               Foreground="{DynamicResource TxtDim}" FontSize="10"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </StackPanel>

                            <!-- Launch button -->
                            <Button Grid.Column="1" Style="{StaticResource LaunchBtn}"
                                    x:Name="BtnLaunch"
                                    Content="▶  Launch ComfyUI"
                                    VerticalAlignment="Center"
                                    Click="BtnLaunch_Click"/>
                        </Grid>

                        <!-- ── Instance actions ─────────────────────────────── -->
                        <Border Background="#1e2a1e" BorderBrush="#2a3a2a"
                                BorderThickness="1" CornerRadius="5"
                                Padding="14,10" Margin="0,14,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           Text="Instance Actions"
                                           Foreground="#4a8a4a" FontSize="11"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <Button x:Name="BtnSetupEnv"
                                            Content="⚙ Setup Environment"
                                            Background="#1a3a1a" Foreground="#4ec9b0"
                                            BorderBrush="#2a5a2a" BorderThickness="1"
                                            Padding="12,6" FontSize="12" Cursor="Hand"
                                            Margin="0,0,8,0"
                                            Click="BtnSetupEnv_Click">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="bd"
                                                        Background="{TemplateBinding Background}"
                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                        BorderThickness="{TemplateBinding BorderThickness}"
                                                        CornerRadius="4"
                                                        Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="bd" Property="Background" Value="#226030"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                    <Button x:Name="BtnCloneInstance"
                                            Content="⎘ Clone"
                                            Background="#1a2a3a" Foreground="#4a9eff"
                                            BorderBrush="#2a4a6a" BorderThickness="1"
                                            Padding="12,6" FontSize="12" Cursor="Hand"
                                            Margin="0,0,8,0"
                                            Click="BtnCloneInstance_Click">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="bd"
                                                        Background="{TemplateBinding Background}"
                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                        BorderThickness="{TemplateBinding BorderThickness}"
                                                        CornerRadius="4"
                                                        Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="bd" Property="Background" Value="#223050"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                    <Button x:Name="BtnDeleteInstance"
                                            Content="🗑 Delete"
                                            Background="#3a1a1a" Foreground="#f47878"
                                            BorderBrush="#5a2a2a" BorderThickness="1"
                                            Padding="12,6" FontSize="12" Cursor="Hand"
                                            Click="BtnDeleteInstance_Click">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="bd"
                                                        Background="{TemplateBinding Background}"
                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                        BorderThickness="{TemplateBinding BorderThickness}"
                                                        CornerRadius="4"
                                                        Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="bd" Property="Background" Value="#501a1a"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Divider -->
                        <Border Height="1" Background="{DynamicResource BorderDim}" Margin="0,16,0,4"/>

                        <!-- ── Runtime info ──────────────────────────────────── -->
                        <TextBlock Style="{StaticResource SectionHeader}"
                                   Text="RUNTIME ENVIRONMENT"/>

                        <Grid x:Name="GridRuntime">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="170"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="170"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="30"/>
                                <RowDefinition Height="30"/>
                                <RowDefinition Height="30"/>
                                <RowDefinition Height="30"/>
                            </Grid.RowDefinitions>

                            <!-- Row 0 -->
                            <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource InfoLabel}" Text="ComfyUI Version"/>
                            <TextBlock Grid.Row="0" Grid.Column="1" Style="{StaticResource InfoValue}" x:Name="TxtComfyVersion"/>

                            <TextBlock Grid.Row="0" Grid.Column="2" Style="{StaticResource InfoLabel}" Text="Port"/>
                            <TextBox   Grid.Row="0" Grid.Column="3" Style="{StaticResource PortEdit}"
                                       x:Name="TxtPort"
                                       KeyDown="TxtPort_KeyDown"
                                       LostFocus="TxtPort_LostFocus"/>

                            <!-- Row 1 -->
                            <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource InfoLabel}" Text="PyTorch"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource InfoValue}" x:Name="TxtPyTorch"/>

                            <TextBlock Grid.Row="1" Grid.Column="2" Style="{StaticResource InfoLabel}" Text="CUDA Build"/>
                            <TextBlock Grid.Row="1" Grid.Column="3" Style="{StaticResource InfoValue}" x:Name="TxtCuda" Foreground="{DynamicResource ColPurple}"/>

                            <!-- Row 2 -->
                            <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource InfoLabel}" Text="TorchVision"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource InfoValue}" x:Name="TxtTorchVision"/>

                            <TextBlock Grid.Row="2" Grid.Column="2" Style="{StaticResource InfoLabel}" Text="Output Folder"/>
                            <TextBlock Grid.Row="2" Grid.Column="3" Style="{StaticResource InfoValue}" x:Name="TxtOutputFolder"
                                       Foreground="{DynamicResource TxtSecondary}" FontFamily="Consolas" FontSize="11"
                                       TextTrimming="CharacterEllipsis"/>

                            <!-- Row 3 -->
                            <TextBlock Grid.Row="3" Grid.Column="0" Style="{StaticResource InfoLabel}" Text="TorchAudio"/>
                            <TextBlock Grid.Row="3" Grid.Column="1" Style="{StaticResource InfoValue}" x:Name="TxtTorchAudio"/>

                            <TextBlock Grid.Row="3" Grid.Column="2" Style="{StaticResource InfoLabel}" Text="Output Files"/>
                            <TextBlock Grid.Row="3" Grid.Column="3" Style="{StaticResource InfoValue}" x:Name="TxtOutputCount" Foreground="{DynamicResource ColYellow}"/>
                        </Grid>

                        <!-- ── Launch Configuration ─────────────────────────── -->
                        <Border Height="1" Background="{DynamicResource BorderDim}" Margin="0,16,0,4"/>
                        <TextBlock Style="{StaticResource SectionHeader}" Text="LAUNCH CONFIGURATION"/>

                        <Grid Margin="0,2,0,0" Height="30">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="170"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Style="{StaticResource InfoLabel}"
                                       Text="Startup Args" VerticalAlignment="Center"/>

                            <TextBox Grid.Column="1"
                                     x:Name="TxtStartupArgs"
                                     Style="{StaticResource ArgsEdit}"
                                     KeyDown="TxtStartupArgs_KeyDown"
                                     LostFocus="TxtStartupArgs_LostFocus"/>

                            <!-- ℹ info button — hover to see common flags -->
                            <Button Grid.Column="2" x:Name="BtnArgsHelp"
                                    Content="ℹ"
                                    Margin="10,0,0,0"
                                    Padding="0"
                                    Width="18" Height="18"
                                    VerticalAlignment="Center"
                                    Cursor="Hand"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    FontSize="13"
                                    Foreground="{DynamicResource TxtDim}">
                                <Button.ToolTip>
                                    <ToolTip MaxWidth="460"
                                             Background="#1a1a2e"
                                             BorderBrush="#3a3a5e"
                                             BorderThickness="1"
                                             Padding="14,12">
                                        <StackPanel>
                                            <TextBlock Text="Common ComfyUI launch flags"
                                                       Foreground="#ffe57f" FontSize="12"
                                                       FontWeight="SemiBold" Margin="0,0,0,10"/>
                                            <TextBlock Text="RECLINER always appends --port automatically."
                                                       Foreground="#888899" FontSize="10" FontStyle="Italic"
                                                       Margin="0,0,0,10"/>

                                            <!-- Flag table -->
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="210"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="22"/>
                                                    <RowDefinition Height="22"/>
                                                    <RowDefinition Height="22"/>
                                                    <RowDefinition Height="6"/>
                                                    <RowDefinition Height="22"/>
                                                    <RowDefinition Height="22"/>
                                                    <RowDefinition Height="6"/>
                                                    <RowDefinition Height="22"/>
                                                    <RowDefinition Height="22"/>
                                                    <RowDefinition Height="22"/>
                                                    <RowDefinition Height="22"/>
                                                    <RowDefinition Height="6"/>
                                                    <RowDefinition Height="22"/>
                                                    <RowDefinition Height="22"/>
                                                </Grid.RowDefinitions>

                                                <!-- VRAM -->
                                                <TextBlock Grid.Row="0" Grid.Column="0" Text="--lowvram"              FontFamily="Consolas" FontSize="11" Foreground="#4ec9b0" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Row="0" Grid.Column="1" Text="Minimize VRAM (GPUs &lt;= 6 GB)" FontSize="11" Foreground="#aaaacc" VerticalAlignment="Center"/>

                                                <TextBlock Grid.Row="1" Grid.Column="0" Text="--medvram"              FontFamily="Consolas" FontSize="11" Foreground="#4ec9b0" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Row="1" Grid.Column="1" Text="Moderate VRAM reduction"       FontSize="11" Foreground="#aaaacc" VerticalAlignment="Center"/>

                                                <TextBlock Grid.Row="2" Grid.Column="0" Text="--cpu"                  FontFamily="Consolas" FontSize="11" Foreground="#4ec9b0" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Row="2" Grid.Column="1" Text="Run entirely on CPU (slow)"    FontSize="11" Foreground="#aaaacc" VerticalAlignment="Center"/>

                                                <!-- Network -->
                                                <TextBlock Grid.Row="4" Grid.Column="0" Text="--listen 0.0.0.0"       FontFamily="Consolas" FontSize="11" Foreground="#9cdcfe" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Row="4" Grid.Column="1" Text="Accept network connections"    FontSize="11" Foreground="#aaaacc" VerticalAlignment="Center"/>

                                                <TextBlock Grid.Row="5" Grid.Column="0" Text="--listen 0.0.0.0 --enable-cors-header" FontFamily="Consolas" FontSize="10" Foreground="#9cdcfe" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Row="5" Grid.Column="1" Text="Network + CORS for remote UI"  FontSize="11" Foreground="#aaaacc" VerticalAlignment="Center"/>

                                                <!-- Performance -->
                                                <TextBlock Grid.Row="7"  Grid.Column="0" Text="--preview-method auto"  FontFamily="Consolas" FontSize="11" Foreground="#c586c0" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Row="7"  Grid.Column="1" Text="Live previews during gen"       FontSize="11" Foreground="#aaaacc" VerticalAlignment="Center"/>

                                                <TextBlock Grid.Row="8"  Grid.Column="0" Text="--fp8-e4m3fn-unet"      FontFamily="Consolas" FontSize="11" Foreground="#c586c0" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Row="8"  Grid.Column="1" Text="FP8 quant (RTX 40xx, faster)"  FontSize="11" Foreground="#aaaacc" VerticalAlignment="Center"/>

                                                <TextBlock Grid.Row="9"  Grid.Column="0" Text="--fast"                 FontFamily="Consolas" FontSize="11" Foreground="#c586c0" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Row="9"  Grid.Column="1" Text="Experimental fast mode"         FontSize="11" Foreground="#aaaacc" VerticalAlignment="Center"/>

                                                <TextBlock Grid.Row="10" Grid.Column="0" Text="--disable-xformers"    FontFamily="Consolas" FontSize="11" Foreground="#c586c0" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Row="10" Grid.Column="1" Text="Disable xformers (try on errors)" FontSize="11" Foreground="#aaaacc" VerticalAlignment="Center"/>

                                                <!-- Debug -->
                                                <TextBlock Grid.Row="12" Grid.Column="0" Text="--verbose"              FontFamily="Consolas" FontSize="11" Foreground="#dcdcaa" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Row="12" Grid.Column="1" Text="Extra logging"                  FontSize="11" Foreground="#aaaacc" VerticalAlignment="Center"/>

                                                <TextBlock Grid.Row="13" Grid.Column="0" Text="--dont-print-server"   FontFamily="Consolas" FontSize="11" Foreground="#dcdcaa" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Row="13" Grid.Column="1" Text="Suppress startup messages"      FontSize="11" Foreground="#aaaacc" VerticalAlignment="Center"/>
                                            </Grid>
                                        </StackPanel>
                                    </ToolTip>
                                </Button.ToolTip>
                            </Button>
                        </Grid>

                        <!-- ── Custom Nodes ──────────────────────────────────── -->
                        <Grid Margin="0,18,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Style="{StaticResource SectionHeader}"
                                       Margin="0" Text="CUSTOM NODES"/>
                            <Border Grid.Column="1" VerticalAlignment="Center"
                                    Background="{DynamicResource BgSelected}" CornerRadius="10" Padding="8,2">
                                <TextBlock x:Name="TxtNodeCount"
                                           Foreground="{DynamicResource Accent}" FontSize="10" FontWeight="SemiBold"/>
                            </Border>
                        </Grid>

                        <DataGrid x:Name="GridNodes"
                                  Style="{StaticResource DarkGrid}"
                                  MaxHeight="280">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="NODE NAME"
                                                    Binding="{Binding Name}"
                                                    Width="*"
                                                    ElementStyle="{StaticResource InfoValue}"/>
                                <DataGridTextColumn Header="VERSION"
                                                    Binding="{Binding Version}"
                                                    Width="120">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{DynamicResource ColYellow}"/>
                                            <Setter Property="FontFamily" Value="Consolas"/>
                                            <Setter Property="FontSize"   Value="12"/>
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTemplateColumn Header="STATUS" Width="70">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding StatusLabel}"
                                                       Foreground="{Binding StatusColor}"
                                                       FontSize="14" FontWeight="Bold"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>

                        <!-- Empty nodes message -->
                        <TextBlock x:Name="TxtNoNodes"
                                   Text="No custom nodes found"
                                   Foreground="{DynamicResource TxtDim}" FontSize="12"
                                   HorizontalAlignment="Center"
                                   Margin="0,12,0,0"
                                   Visibility="Collapsed"/>

                        <!-- ── Failed Imports ────────────────────────────────── -->
                        <Grid x:Name="PanelFailed" Margin="0,8,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Margin="0,10,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Style="{StaticResource SectionHeader}"
                                           Margin="0" Text="FAILED IMPORTS"/>
                                <Border Grid.Column="1" VerticalAlignment="Center"
                                        Background="#4a1a1a" CornerRadius="10" Padding="8,2">
                                    <TextBlock x:Name="TxtFailedCount"
                                               Foreground="{DynamicResource ColRed}" FontSize="10" FontWeight="SemiBold"/>
                                </Border>
                            </Grid>

                            <ItemsControl Grid.Row="1" x:Name="ListFailed">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#2a1a1a"
                                                BorderBrush="#4a2a2a" BorderThickness="1"
                                                CornerRadius="4" Padding="10,6"
                                                Margin="0,0,0,4">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="✗" Foreground="{DynamicResource ColRed}"
                                                           FontWeight="Bold" FontSize="13"
                                                           Margin="0,0,8,0"
                                                           VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding}"
                                                           Foreground="#d07070"
                                                           FontFamily="Consolas" FontSize="12"
                                                           VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>

                        <!-- Bottom padding -->
                        <Border Height="20"/>

                    </StackPanel>
                </ScrollViewer>

            </Grid>

        </Grid>

        <!-- ════════════════════════════════════════════════════════════════════
             STATUS BAR
             ════════════════════════════════════════════════════════════════════ -->
        <Border Grid.Row="2" Background="{DynamicResource BgHeader}"
                BorderBrush="{DynamicResource BorderDim}" BorderThickness="0,1,0,0">
            <Grid Margin="12,0">
                <TextBlock x:Name="TxtStatus"
                           Foreground="#ffe57f" FontSize="11"
                           VerticalAlignment="Center"/>
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center">
                    <TextBlock x:Name="TxtDistro"
                               Foreground="{DynamicResource TxtDim}" FontSize="11"
                               Margin="0,0,14,0"/>
                    <TextBlock x:Name="TxtParentPath"
                               Foreground="{DynamicResource TxtDim}" FontSize="11"
                               FontFamily="Consolas"/>
                </StackPanel>
            </Grid>
        </Border>

    </Grid>
</Window>
