<Window x:Class="Recliner.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RECLINER — Settings"
        Width="540" Height="720"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BgMain}"
        FontFamily="Segoe UI" FontSize="13">

    <Window.Resources>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground"  Value="{DynamicResource TxtLabel}"/>
            <Setter Property="FontSize"    Value="11"/>
            <Setter Property="FontWeight"  Value="SemiBold"/>
            <Setter Property="Margin"      Value="0,0,0,5"/>
        </Style>

        <Style x:Key="FieldHint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TxtDim}"/>
            <Setter Property="FontSize"   Value="11"/>
            <Setter Property="Margin"     Value="0,4,0,0"/>
        </Style>

        <Style x:Key="DarkTextBox" TargetType="TextBox">
            <Setter Property="Background"      Value="{DynamicResource BgInput}"/>
            <Setter Property="Foreground"      Value="{DynamicResource TxtPrimary}"/>
            <Setter Property="BorderBrush"     Value="{DynamicResource BorderMid}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding"         Value="8,6"/>
            <Setter Property="CaretBrush"      Value="{DynamicResource TxtPrimary}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter Property="BorderBrush" Value="{DynamicResource Accent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- DarkCombo is defined in App.xaml -->

        <Style x:Key="AccentBtn" TargetType="Button">
            <Setter Property="Background"      Value="{DynamicResource Accent}"/>
            <Setter Property="Foreground"      Value="#ffffff"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding"         Value="20,8"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource AccentHov}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GhostBtn" TargetType="Button">
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="Foreground"      Value="{DynamicResource TxtSecondary}"/>
            <Setter Property="BorderBrush"     Value="{DynamicResource BorderMid}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding"         Value="16,8"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource BgSurface2}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource TxtSecondary}"/>
        </Style>

        <!-- Theme card button -->
        <Style x:Key="ThemeCard" TargetType="Button">
            <Setter Property="Background"      Value="{DynamicResource BgSurface}"/>
            <Setter Property="BorderBrush"     Value="{DynamicResource BorderMid}"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Padding"         Value="0"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="12,10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource BgSurface2}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="44"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="60"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="{DynamicResource BgHeader}"
                BorderBrush="{DynamicResource BorderDim}" BorderThickness="0,0,0,1">
            <TextBlock Text="Settings" Foreground="{DynamicResource TxtPrimary}"
                       FontSize="14" FontWeight="SemiBold"
                       VerticalAlignment="Center" Margin="20,0"/>
        </Border>

        <!-- Content -->
        <ScrollViewer Grid.Row="1" Padding="24,20,24,8"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <!-- WSL Distro -->
                <StackPanel Margin="0,0,0,16">
                    <TextBlock Style="{StaticResource FieldLabel}" Text="LINUX ENVIRONMENT"/>
                    <ComboBox x:Name="CboDistro" Style="{StaticResource DarkCombo}"/>
                    <TextBlock Style="{StaticResource FieldHint}"
                               Text="The Linux environment where your ComfyUI instances are installed."/>
                </StackPanel>

                <!-- Parent path -->
                <StackPanel Margin="0,0,0,16">
                    <TextBlock Style="{StaticResource FieldLabel}" Text="COMFYUI INSTANCES FOLDER"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" x:Name="TxtParent"
                                 Style="{StaticResource DarkTextBox}"
                                 FontFamily="Consolas" Margin="0,0,6,0"/>
                        <Button Grid.Column="1" Style="{StaticResource GhostBtn}"
                                Content="Browse…" Padding="10,6"
                                Tag="Parent" Click="BtnBrowse_Click"/>
                    </Grid>
                    <TextBlock Style="{StaticResource FieldHint}"
                               Text="e.g.  /home/skynetlab_user/ai-projects/comfyui"/>
                </StackPanel>

                <!-- Shared models -->
                <StackPanel Margin="0,0,0,16">
                    <TextBlock Style="{StaticResource FieldLabel}" Text="SHARED MODELS FOLDER"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" x:Name="TxtSharedModels"
                                 Style="{StaticResource DarkTextBox}"
                                 FontFamily="Consolas" Margin="0,0,6,0"/>
                        <Button Grid.Column="1" Style="{StaticResource GhostBtn}"
                                Content="Browse…" Padding="10,6"
                                Tag="Models" Click="BtnBrowse_Click"/>
                    </Grid>
                    <TextBlock Style="{StaticResource FieldHint}"
                               Text="All instances share this model folder. Subdirs (checkpoints, loras, vae…) are auto-created."/>
                </StackPanel>

                <!-- Shared output -->
                <StackPanel Margin="0,0,0,16">
                    <TextBlock Style="{StaticResource FieldLabel}" Text="SHARED OUTPUT FOLDER"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" x:Name="TxtSharedOutput"
                                 Style="{StaticResource DarkTextBox}"
                                 FontFamily="Consolas" Margin="0,0,6,0"/>
                        <Button Grid.Column="1" Style="{StaticResource GhostBtn}"
                                Content="Browse…" Padding="10,6"
                                Tag="Output" Click="BtnBrowse_Click"/>
                    </Grid>
                    <TextBlock Style="{StaticResource FieldHint}"
                               Text="Each instance writes to a subdirectory here named after the instance."/>
                </StackPanel>

                <!-- Preferred CUDA -->
                <StackPanel Margin="0,0,0,16">
                    <TextBlock Style="{StaticResource FieldLabel}" Text="PREFERRED CUDA VERSION"/>
                    <ComboBox x:Name="CboCuda" Style="{StaticResource DarkCombo}"/>
                    <TextBlock Style="{StaticResource FieldHint}"
                               Text="Default for new instance setup. RTX 30/40 → cu124."/>
                </StackPanel>

                <!-- ComfyUI Git URL -->
                <StackPanel Margin="0,0,0,16">
                    <TextBlock Style="{StaticResource FieldLabel}" Text="COMFYUI GIT URL"/>
                    <TextBox x:Name="TxtGitUrl" Style="{StaticResource DarkTextBox}"
                             FontFamily="Consolas"/>
                </StackPanel>

                <!-- Default launch command -->
                <StackPanel Margin="0,0,0,16">
                    <TextBlock Style="{StaticResource FieldLabel}" Text="DEFAULT LAUNCH COMMAND"/>
                    <TextBox x:Name="TxtLaunch" Style="{StaticResource DarkTextBox}"
                             FontFamily="Consolas"/>
                    <TextBlock Style="{StaticResource FieldHint}"
                               Text="--port and --output-directory are appended automatically."/>
                </StackPanel>

                <!-- Open browser -->
                <StackPanel Margin="0,0,0,20">
                    <CheckBox x:Name="ChkOpenBrowser"
                              Content="Open browser automatically after launch (3 second delay)"/>
                </StackPanel>

                <!-- ── Theme selector ──────────────────────────────────────── -->
                <Border Background="{DynamicResource BgSurface}"
                        BorderBrush="{DynamicResource BorderMid}"
                        BorderThickness="1" CornerRadius="6"
                        Padding="16,14" Margin="0,0,0,8">
                    <StackPanel>
                        <TextBlock Text="APPEARANCE"
                                   Foreground="{DynamicResource TxtLabel}"
                                   FontSize="11" FontWeight="SemiBold"
                                   Margin="0,0,0,12"/>

                        <UniformGrid Rows="1" Columns="3">

                            <!-- Default Dark -->
                            <Button x:Name="BtnThemeDefault"
                                    Style="{StaticResource ThemeCard}"
                                    Tag="Default"
                                    Click="BtnTheme_Click"
                                    Margin="0,0,6,0">
                                <StackPanel>
                                    <!-- Colour swatch -->
                                    <Border CornerRadius="4" Height="28" Margin="0,0,0,8">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                <GradientStop Color="#1a1a1a" Offset="0"/>
                                                <GradientStop Color="#242424" Offset="0.5"/>
                                                <GradientStop Color="#4a9eff" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Border.Background>
                                    </Border>
                                    <TextBlock Text="Default Dark"
                                               Foreground="{DynamicResource TxtPrimary}"
                                               FontSize="12" FontWeight="SemiBold"
                                               HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="TxtThemeDefaultCheck"
                                               Text="✓ Active"
                                               Foreground="{DynamicResource ColGreen}"
                                               FontSize="10"
                                               HorizontalAlignment="Center"
                                               Margin="0,3,0,0"
                                               Visibility="Collapsed"/>
                                </StackPanel>
                            </Button>

                            <!-- Rose Gold Standard -->
                            <Button x:Name="BtnThemeRoseGold"
                                    Style="{StaticResource ThemeCard}"
                                    Tag="RoseGold"
                                    Click="BtnTheme_Click"
                                    Margin="3,0,3,0">
                                <StackPanel>
                                    <Border CornerRadius="4" Height="28" Margin="0,0,0,8">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                <GradientStop Color="#1c1618" Offset="0"/>
                                                <GradientStop Color="#251e22" Offset="0.5"/>
                                                <GradientStop Color="#c8788a" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Border.Background>
                                    </Border>
                                    <TextBlock Text="Rose Gold Standard"
                                               Foreground="{DynamicResource TxtPrimary}"
                                               FontSize="12" FontWeight="SemiBold"
                                               HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="TxtThemeRoseGoldCheck"
                                               Text="✓ Active"
                                               Foreground="{DynamicResource ColGreen}"
                                               FontSize="10"
                                               HorizontalAlignment="Center"
                                               Margin="0,3,0,0"
                                               Visibility="Collapsed"/>
                                </StackPanel>
                            </Button>

                            <!-- Cotton Candy UI -->
                            <Button x:Name="BtnThemeCottonCandy"
                                    Style="{StaticResource ThemeCard}"
                                    Tag="CottonCandy"
                                    Click="BtnTheme_Click"
                                    Margin="6,0,0,0">
                                <StackPanel>
                                    <Border CornerRadius="4" Height="28" Margin="0,0,0,8">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                <GradientStop Color="#18161e" Offset="0"/>
                                                <GradientStop Color="#201c28" Offset="0.5"/>
                                                <GradientStop Color="#e890c8" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Border.Background>
                                    </Border>
                                    <TextBlock Text="Cotton Candy UI"
                                               Foreground="{DynamicResource TxtPrimary}"
                                               FontSize="12" FontWeight="SemiBold"
                                               HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="TxtThemeCottonCandyCheck"
                                               Text="✓ Active"
                                               Foreground="{DynamicResource ColGreen}"
                                               FontSize="10"
                                               HorizontalAlignment="Center"
                                               Margin="0,3,0,0"
                                               Visibility="Collapsed"/>
                                </StackPanel>
                            </Button>

                        </UniformGrid>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- Footer buttons -->
        <Border Grid.Row="2" Background="{DynamicResource BgHeader}"
                BorderBrush="{DynamicResource BorderDim}" BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                        VerticalAlignment="Center" Margin="20,0">
                <Button Style="{StaticResource GhostBtn}" Content="Cancel"
                        Margin="0,0,10,0"
                        Click="BtnCancel_Click"/>
                <Button Style="{StaticResource AccentBtn}" Content="Save Settings"
                        Click="BtnSave_Click" IsDefault="True"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
