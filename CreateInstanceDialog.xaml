<Window x:Class="Recliner.CreateInstanceDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RECLINER — New Instance"
        Width="520" Height="480"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BgMain}"
        FontFamily="Segoe UI" FontSize="13">

    <Window.Resources>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TxtLabel}"/>
            <Setter Property="FontSize"   Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin"     Value="0,0,0,5"/>
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TxtDim}"/>
            <Setter Property="FontSize"   Value="11"/>
            <Setter Property="Margin"     Value="0,4,0,0"/>
        </Style>
        <Style x:Key="DarkTextBox" TargetType="TextBox">
            <Setter Property="Background"      Value="{DynamicResource BgInput}"/>
            <Setter Property="Foreground"      Value="{DynamicResource TxtPrimary}"/>
            <Setter Property="BorderBrush"     Value="{DynamicResource BorderMid}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding"         Value="8,6"/>
            <Setter Property="CaretBrush"      Value="{DynamicResource TxtPrimary}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter Property="BorderBrush" Value="{DynamicResource Accent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- DarkCombo is defined in App.xaml -->
        <Style x:Key="ModeBtn" TargetType="Button">
            <Setter Property="Background"      Value="{DynamicResource BgSurface2}"/>
            <Setter Property="Foreground"      Value="{DynamicResource TxtDim}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush"     Value="{DynamicResource BorderMid}"/>
            <Setter Property="Padding"         Value="0"/>
            <Setter Property="FontSize"        Value="12"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="0,10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="AccentBtn" TargetType="Button">
            <Setter Property="Background"      Value="{DynamicResource Accent}"/>
            <Setter Property="Foreground"      Value="#ffffff"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding"         Value="22,9"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource AccentHov}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource AccentDisabled}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TxtDim}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="GhostBtn" TargetType="Button">
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="Foreground"      Value="{DynamicResource TxtSecondary}"/>
            <Setter Property="BorderBrush"     Value="{DynamicResource BorderMid}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding"         Value="16,9"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource BgSurface2}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="44"/>   <!-- header -->
            <RowDefinition Height="52"/>   <!-- mode toggle -->
            <RowDefinition Height="*"/>    <!-- fields -->
            <RowDefinition Height="62"/>   <!-- footer -->
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="{DynamicResource BgHeader}"
                BorderBrush="{DynamicResource BorderDim}" BorderThickness="0,0,0,1">
            <TextBlock x:Name="TxtTitle"
                       Text="New ComfyUI Instance"
                       Foreground="{DynamicResource TxtPrimary}" FontSize="14" FontWeight="SemiBold"
                       VerticalAlignment="Center" Margin="20,0"/>
        </Border>

        <!-- Mode toggle -->
        <Border Grid.Row="1" Background="{DynamicResource BgSurface}"
                BorderBrush="{DynamicResource BorderDim}" BorderThickness="0,0,0,1"
                Padding="20,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" x:Name="BtnModeNew"
                        Style="{StaticResource ModeBtn}"
                        Content="⬜  Fresh Clone"
                        Click="BtnModeNew_Click"
                        Margin="0,0,4,0"/>
                <Button Grid.Column="1" x:Name="BtnModeClone"
                        Style="{StaticResource ModeBtn}"
                        Content="⎘  Clone Existing"
                        Click="BtnModeClone_Click"
                        Margin="4,0,0,0"/>
            </Grid>
        </Border>

        <!-- Fields -->
        <ScrollViewer Grid.Row="2" Padding="20,16,20,8"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <!-- Instance name -->
                <TextBlock Style="{StaticResource Label}" Text="INSTANCE NAME"/>
                <TextBox x:Name="TxtName" Style="{StaticResource DarkTextBox}"
                         FontFamily="Consolas"
                         TextChanged="TxtName_TextChanged"/>
                <TextBlock Style="{StaticResource Hint}"
                           Text="Subfolder name created under your parent directory."/>

                <!-- Source (clone mode only) -->
                <StackPanel x:Name="PanelSource" Margin="0,14,0,0" Visibility="Collapsed">
                    <TextBlock Style="{StaticResource Label}" Text="SOURCE INSTANCE"/>
                    <ComboBox x:Name="CboSource" Style="{StaticResource DarkCombo}"/>
                    <TextBlock Style="{StaticResource Hint}"
                               Text="All packages are mirrored exactly from the source instance."/>
                </StackPanel>

                <!-- CUDA version -->
                <StackPanel Margin="0,14,0,0">
                    <TextBlock Style="{StaticResource Label}" Text="CUDA VERSION"/>
                    <ComboBox x:Name="CboCuda" Style="{StaticResource DarkCombo}"/>
                    <TextBlock Style="{StaticResource Hint}"
                               Text="Match your installed CUDA toolkit. RTX 30/40 series → cu124."/>
                </StackPanel>

                <!-- Git URL (fresh mode only) -->
                <StackPanel x:Name="PanelGitUrl" Margin="0,14,0,0">
                    <TextBlock Style="{StaticResource Label}" Text="COMFYUI GIT URL"/>
                    <TextBox x:Name="TxtGitUrl" Style="{StaticResource DarkTextBox}"
                             FontFamily="Consolas"/>
                </StackPanel>

                <!-- Info box showing what will happen -->
                <Border x:Name="InfoBox" Background="#1a2a1a"
                        BorderBrush="#2a4a2a" BorderThickness="1"
                        CornerRadius="4" Padding="12,10"
                        Margin="0,16,0,0">
                    <StackPanel>
                        <TextBlock Text="WHAT THIS WILL DO" Foreground="#4a8a4a"
                                   FontSize="10" FontWeight="SemiBold" Margin="0,0,0,6"/>
                        <TextBlock x:Name="TxtInfoBox" Foreground="#8ab88a"
                                   FontSize="11" TextWrapping="Wrap"
                                   LineHeight="18"/>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- Footer -->
        <Border Grid.Row="3" Background="{DynamicResource BgHeader}"
                BorderBrush="{DynamicResource BorderDim}" BorderThickness="0,1,0,0">
            <Grid Margin="20,0">
                <TextBlock x:Name="TxtValidation"
                           Foreground="{DynamicResource ColRed}" FontSize="11"
                           VerticalAlignment="Center"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                            VerticalAlignment="Center">
                    <Button Style="{StaticResource GhostBtn}" Content="Cancel"
                            Margin="0,0,10,0" Click="BtnCancel_Click"/>
                    <Button Style="{StaticResource AccentBtn}"
                            x:Name="BtnCreate" Content="▶  Create &amp; Setup"
                            IsEnabled="False"
                            Click="BtnCreate_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
